# Copiá este archivo a .env.local para desarrollo, y cargá las mismas
# variables en Vercel (Project Settings -> Environment Variables) para prod.
# NUNCA commitees .env.local: ya está en .gitignore.

# --- Email de contacto (Resend: https://resend.com, plan free) ---
# Sin esto el formulario sigue funcionando: cae a WhatsApp automáticamente.
RESEND_API_KEY=
# A dónde llegan los leads (por defecto joaquinflores2207@gmail.com).
CONTACT_TO_EMAIL=
# Remitente. Con el dominio de prueba de Resend: "Estudio Flores <onboarding@resend.dev>"
# (solo entrega a la casilla con la que te registraste). Con dominio propio
# verificado en Resend: "Estudio Flores <hola@tudominio.com>".
CONTACT_FROM_EMAIL=

# --- Rate limiting distribuido (opcional) ---
# Si no cargás esto, el rate limiter usa memoria local (alcanza para bajo
# tráfico). Para conteo real entre instancias, creá un Redis en Upstash
# (https://upstash.com, plan free) o usá la integración Vercel KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
